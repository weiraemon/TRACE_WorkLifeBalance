{
  "name": "atlas-personal-workbench",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx apps/local-service/src/server.ts",
    "start": "tsx apps/local-service/src/server.ts --production",
    "build": "tsc --noEmit && vite build",
    "build:android:web": "tsc --noEmit && vite build --config vite.android.config.ts",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:open": "cap open android",
    "test:android": "node scripts/test-android.mjs",
    "preview:android": "node scripts/preview-android.mjs",
    "package:android": "npm run android:sync && node scripts/build-android.mjs",
    "package:android:release": "npm run android:sync && node scripts/build-android.mjs --release",
    "package:android:preview": "npm run build:desktop && node scripts/package-android-preview.mjs",
    "test:android:preview": "node scripts/test-android-preview.mjs",
    "schema:exchange": "tsx scripts/exchange-schema.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .desktop",
    "package:desktop": "npm run build:desktop && node scripts/package-desktop.mjs",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:release": "node scripts/test-desktop-release.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages tests scripts *.ts *.json *.md \"docs/**/*.md\"",
    "check": "npm run check:architecture && npm test && npm run build && npm run test:e2e",
    "check:architecture": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@electron/packager": "^18.4.4",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  }
}
